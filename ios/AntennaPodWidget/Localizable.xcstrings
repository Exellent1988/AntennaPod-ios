    "Shows the episode you were last listening to. Tap to open AntennaPod.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the episode you were last listening to. Tap to open AntennaPod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Episode, die du zuletzt gehört hast. Tippen öffnet AntennaPod."
