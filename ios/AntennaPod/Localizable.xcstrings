          }
        }
      }
    },
    "Stops after the last episode in the queue. No confirmation. Replaces any active clock, End of episode, or End of chapter sleep timer. Does not pause or stop playback now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
