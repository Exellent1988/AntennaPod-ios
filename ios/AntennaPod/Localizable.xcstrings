    "Subscription list exported from AntennaPod iOS. Local folder podcasts are omitted. Author, language, categories, and funding appear only when provided by each feed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription list exported from AntennaPod iOS. Local folder podcasts are omitted. Author, language, categories, and funding appear only when provided by each feed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementliste aus AntennaPod iOS exportiert. Lokale Ordner-Podcasts sind ausgelassen. Autor, Sprache, Kategorien und Unterstützung erscheinen nur, wenn der Feed sie liefert."
          }
        }
      }
    },
