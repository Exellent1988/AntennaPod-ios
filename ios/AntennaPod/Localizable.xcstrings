          }
        }
      },
      "comment": "VoiceOver hint for All Episodes podcast filter chips."
    },
    "Appends %lld episodes to the end of the queue (newest first within the newest-500 soft cap). Already queued episodes are skipped. Uses the soft-capped All Episodes catalog (newest 500 by publish date), not the chip, podcast, or search filter. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld episodes to the end of the queue (newest first within the newest-500 soft cap). Already queued episodes are skipped. Uses the soft-capped All Episodes catalog (newest 500 by publish date), not the chip, podcast, or search filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht %lld Episoden am Ende der Warteschlange ein (neueste zuerst innerhalb Soft-Cap neueste 500). Bereits eingereihte Episoden werden übersprungen. Nutzt den Soft-Cap-All-Episodes-Katalog (neueste 500 nach Erscheinungsdatum), nicht Chip-, Podcast- oder Suchfilter. Warteschlangen-Sperre blockiert Einreihen nicht."
          }
        }
      },
      "comment": "All Episodes Add all to queue confirmation message (soft-cap honesty; not chip/podcast/search)."
    },
    "Appends %lld episodes to the end of the queue (newest first within the newest-500 soft cap). Already queued episodes are skipped. Uses the soft-capped All Episodes catalog (newest 500 by publish date), not the status, podcast, type, or search filter. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld episodes to the end of the queue (newest first within the newest-500 soft cap). Already queued episodes are skipped. Uses the soft-capped All Episodes catalog (newest 500 by publish date), not the status, podcast, type, or search filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht %lld Episoden am Ende der Warteschlange ein (neueste zuerst innerhalb des Soft-Caps der neuesten 500). Bereits eingereihte Episoden werden übersprungen. Nutzt den Soft-Cap-Katalog aller Episoden (neueste 500 nach Veröffentlichungsdatum), nicht Status-, Podcast-, Typ- oder Suchfilter. Die Warteschlangen-Sperre blockiert das Einreihen nicht."
          }
        }
      }
    },
