          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld archived episodes to the end of the queue (newest archived first). Already queued episodes are skipped. Uses the full Archived catalog (same as Restore all), not the searchable filter. Does not restore or unarchive. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
