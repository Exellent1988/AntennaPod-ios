          }
        }
      }
    },
    "iOS notification permission is still being checked. This is not Allowed, Denied, Not determined, Temporary, or Unknown, and this toggle does not claim a banner will appear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS notification permission is still being checked. This is not Allowed, Denied, Not determined, Temporary, or Unknown, and this toggle does not claim a banner will appear."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-Benachrichtigungsberechtigung wird noch geprüft. Das ist weder Erlaubt, Abgelehnt, Nicht festgelegt, Vorübergehend noch Unbekannt, und dieser Schalter behauptet nicht, dass ein Banner erscheint."
          }
        }
      }
    },
    "iOS notification permission is Allowed. A local banner can be posted when this toggle is on and the event happens. Not a push or APNs grant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS notification permission is Allowed. A local banner can be posted when this toggle is on and the event happens. Not a push or APNs grant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-Benachrichtigungsberechtigung ist Erlaubt. Ein lokales Banner kann erscheinen, wenn dieser Schalter an ist und das Ereignis eintritt. Keine Push- oder APNs-Freigabe."
          }
        }
      }
    },
    "iOS notification permission is Denied. The saved On or Off choice stays, but no local banner is posted until Notifications are allowed in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS notification permission is Denied. The saved On or Off choice stays, but no local banner is posted until Notifications are allowed in iOS Settings."
