    },
    "iOS notification permission is Temporary. This beta posts local banners only for authorized or provisional, so no banner is posted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS notification permission is Temporary. This beta posts local banners only for authorized or provisional, so no banner is posted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-Benachrichtigungsberechtigung ist Vorübergehend. Diese Beta postet lokale Banner nur bei authorized oder provisional, daher wird kein Banner gepostet."
          }
        }
      }
    },
    "Checking. iOS notification authorization has not been read yet, so this is not Allowed, Denied, Not determined, Temporary, or Unknown. No permission is invented. Local UserNotifications only — no push or APNs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking. iOS notification authorization has not been read yet, so this is not Allowed, Denied, Not determined, Temporary, or Unknown. No permission is invented. Local UserNotifications only — no push or APNs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe. Die iOS-Benachrichtigungsberechtigung wurde noch nicht gelesen, also ist das weder Erlaubt, Abgelehnt, Nicht festgelegt, Vorübergehend noch Unbekannt. Es wird keine Berechtigung erfunden. Nur lokale UserNotifications — kein Push und kein APNs."
          }
        }
      }
    },
    "Allowed. Local banners can be posted when a notification toggle is on and an event happens. This is not a push or APNs grant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed. Local banners can be posted when a notification toggle is on and an event happens. This is not a push or APNs grant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt. Lokale Banner können erscheinen, wenn ein Benachrichtigungsschalter an ist und ein Ereignis eintritt. Das ist keine Push- oder APNs-Freigabe."
          }
        }
      }
    },
    "Denied. Saved On or Off choices stay, but local banners stay off until Notifications are allowed in iOS Settings. No push or APNs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied. Saved On or Off choices stay, but local banners stay off until Notifications are allowed in iOS Settings. No push or APNs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelehnt. Gespeicherte An- oder Aus-Wahl bleibt, aber lokale Banner bleiben aus, bis Mitteilungen in den iOS-Einstellungen erlaubt sind. Kein Push und kein APNs."
          }
        }
      }
    },
    "Not determined. iOS has not been asked. Turning a notification toggle on asks for permission and does not post a banner by itself. No push or APNs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not determined. iOS has not been asked. Turning a notification toggle on asks for permission and does not post a banner by itself. No push or APNs."
          }
        },
        "de": {
          "stringUnit": {
