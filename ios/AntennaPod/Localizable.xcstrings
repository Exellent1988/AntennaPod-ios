    "Shuffle, reverse, or clear the entire queue after confirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle, reverse, or clear the entire queue after confirmation"
          }
        },
