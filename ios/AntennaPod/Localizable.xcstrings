        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gpodder.net or Nextcloud Gpodder Sync. Switching logs out and clears sync cursors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gpodder.net oder Nextcloud Gpodder Sync. Wechsel meldet ab und löscht Sync-Cursor."
          }
        }
      },
      "comment": "Provider picker VoiceOver hint"
    },
    "Nextcloud server root or full Gpodder Sync API path.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud server root or full Gpodder Sync API path."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud-Server-Root oder voller Gpodder-Sync-API-Pfad."
          }
        }
      },
      "comment": "Nextcloud host field VoiceOver hint"
    },
    "gpodder.net host. Default is https://gpodder.net.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gpodder.net host. Default is https://gpodder.net."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gpodder.net-Host. Standard ist https://gpodder.net."
          }
