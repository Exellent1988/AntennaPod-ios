    "Unsubscribe and delete %lld downloads (%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsubscribe and delete %lld downloads (%@)"
          }
        },
        "de": {
          "stringUnit": {
