    "Limits how many episode downloads run as active transfers at once (1–5, default 3). Extra downloads wait in memory until a slot frees. Waiting items are not persisted across process death; already-started background URLSession tasks continue after relaunch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits how many episode downloads run as active transfers at once (1–5, default 3). Extra downloads wait in memory until a slot frees. Waiting items are not persisted across process death; already-started background URLSession tasks continue after relaunch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt, wie viele Episode-Downloads gleichzeitig als aktive Transfers laufen (1–5, Standard 3). Weitere Downloads warten im Speicher, bis ein Slot frei wird. Wartende Einträge werden bei Prozessende nicht persistiert; bereits gestartete Hintergrund-URLSession-Tasks laufen nach dem Neustart weiter."
          }
        }
      }
    },
    "Max storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
