          }
        }
      }
    },
    "New-episode banners stay off for every podcast. A per-podcast On does not override this. This does not post a banner and does not change downloads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New-episode banners stay off for every podcast. A per-podcast On does not override this. This does not post a banner and does not change downloads."
          }
