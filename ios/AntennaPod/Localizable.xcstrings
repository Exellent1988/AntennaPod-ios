      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many episode rows each Home section preview shows (Continue, Inbox, Queue, Favorites, History, Archived, Downloads). Soft-cap after search filter — preview is not the full tab. Does not change Discover charts or Recently updated feed cards. Default 5. Always capped — no unlimited."
          }
