          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt nach der letzten Episode in der Queue. Keine Bestätigung. Ersetzt jeden aktiven Uhr-, Ende-der-Episode- oder Ende-des-Kapitels-Sleep-Timer. Pausiert oder stoppt die Wiedergabe jetzt nicht."
          }
        }
      }
    },
    "Starts a %lld-minute clock sleep timer. No confirmation. Replaces any active End of episode, End of chapter, or End of queue sleep timer. Does not pause playback now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
