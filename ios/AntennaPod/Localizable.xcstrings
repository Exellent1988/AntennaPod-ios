        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine ganze Zahl von 1 bis 600 Sekunden ein."
          }
        }
      }
    },
    "Adjusts the threshold in one-second steps. Valid range is 1 to 600 seconds remaining.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts the threshold in one-second steps. Valid range is 1 to 600 seconds remaining."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt den Schwellwert in Ein-Sekunden-Schritten an. Gültiger Bereich: 1 bis 600 Sekunden Restzeit."
          }
        }
      }
    },
    "Saves this custom interval for the selected rewind or fast-forward action": {
