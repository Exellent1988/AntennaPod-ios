    "Choose between 1 and 600 seconds remaining. Presets (Off / 15 / 30 / 60 / 120 / 300 / 600) stay in Settings. Marks played when leaving or stopping within this window — not a percent threshold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between 1 and 600 seconds remaining. Presets (Off / 15 / 30 / 60 / 120 / 300 / 600) stay in Settings. Marks played when leaving or stopping within this window — not a percent threshold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen 1 und 600 Sekunden Restzeit. Presets (Aus / 15 / 30 / 60 / 120 / 300 / 600) bleiben in den Einstellungen. Markiert als gehört beim Verlassen oder Stoppen in diesem Fenster — kein Prozent-Schwellwert."
          }
        }
      }
    },
    "Enter a whole number from 1 to 600 seconds remaining. The Set button stays unavailable until the value is valid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number from 1 to 600 seconds remaining. The Set button stays unavailable until the value is valid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine ganze Zahl von 1 bis 600 Sekunden Restzeit ein. Festlegen bleibt deaktiviert, bis der Wert gültig ist."
          }
        }
      }
    },
    "Enter a whole number from 1 to 600 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number from 1 to 600 seconds."
