      "comment": "Mini and full player delete-download confirmation"
    },
    "Delete download for \"%@\"? Removes the local offline file only. Keeps played status, queue membership, favorites, and archive state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
