        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Episoden = Audiodateien im Ordner. Wiedergabe offline über den Dateipfad. Leere Ordner sind erlaubt — später Dateien hinzufügen und dann Neu scannen."
