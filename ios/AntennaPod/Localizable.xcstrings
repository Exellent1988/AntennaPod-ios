    "Opens Home layout to show, hide, and reorder Home sections. Same editor as Settings → Home layout. Does not invent a Downloads Home section.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Home layout to show, hide, and reorder Home sections. Same editor as Settings → Home layout. Does not invent a Downloads Home section."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Startseiten-Layout zum Ein-/Ausblenden und Neuordnen der Home-Abschnitte. Derselbe Editor wie Einstellungen → Startseiten-Layout. Erfindet keinen Downloads-Home-Abschnitt."
          }
        }
      }
    },
    "Show, hide, and drag-reorder Home tab sections. Same editor as Home toolbar Configure Home. Persisted in AppSettings / backup. No Downloads Home section.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show, hide, and drag-reorder Home tab sections. Same editor as Home toolbar Configure Home. Persisted in AppSettings / backup. No Downloads Home section."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Tab-Abschnitte ein-/ausblenden und per Ziehen neu ordnen. Derselbe Editor wie Home-Toolbar „Home konfigurieren“. Gespeichert in AppSettings / Backup. Kein Downloads-Home-Abschnitt."
          }
