          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt nach Bestätigung alle Lesezeichen für diese Episode. Betrifft keine anderen Episoden, Kapitel, Mit Position teilen, die private Notiz dieser Episode, Wiedergabe, Favoriten oder die Warteschlange."
          }
        }
      }
    },
