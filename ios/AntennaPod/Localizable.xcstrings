          "stringUnit": {
            "state": "translated",
            "value": "Marks %lld unplayed, non-archived favorite episode(s) as played. Uses the full Favorites catalog (newest favorited first), not the podcast, search, or sort filter. Auto-delete after playing still applies when enabled; this does not clear Favorites, unfavorite episodes, or delete downloads itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert %lld ungehörte, nicht archivierte Favoriten-Episode(n) als gehört. Nutzt den vollständigen Favoriten-Katalog (zuletzt favorisiert zuerst), nicht Podcast-, Such- oder Sortierfilter. Automatisches Löschen nach dem Abspielen gilt weiterhin, wenn aktiviert; diese Aktion entfernt weder Favoriten noch löscht sie Downloads selbst."
          }
        }
      }
    },
