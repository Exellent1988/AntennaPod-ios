        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbleibende Zeit anzeigen"
          }
        }
      }
    },
    "When on, the mini and full player show remaining time (−m:ss) on the right instead of total duration. Left stays current position. Tap the full-player duration/remaining label to toggle. Default off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the mini and full player show remaining time (−m:ss) on the right instead of total duration. Left stays current position. Tap the full-player duration/remaining label to toggle. Default off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, zeigen Mini- und Vollbild-Player rechts die verbleibende Zeit (−m:ss) statt der Gesamtdauer. Links bleibt die aktuelle Position. Tippen auf das Dauer-/Restzeit-Label im Vollbild-Player schaltet um. Standard aus."
          }
        }
      }
    },
