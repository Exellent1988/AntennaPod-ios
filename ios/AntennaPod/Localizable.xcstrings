          }
        }
      }
    },
    "Local only on this device — not from RSS, not synced to gpodder, and not written to OPML, HTML export, chapters, or Share. Distinct from bookmarks. Included in iOS JSON backup. Cleared when you unsubscribe from the podcast. Maximum 1000 characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local only on this device — not from RSS, not synced to gpodder, and not written to OPML, HTML export, chapters, or Share. Distinct from bookmarks. Included in iOS JSON backup. Cleared when you unsubscribe from the podcast. Maximum 1000 characters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lokal auf diesem Gerät — nicht aus RSS, nicht mit gpodder synchronisiert und nicht in OPML, HTML-Export, Kapitel oder Teilen geschrieben. Anders als Lesezeichen. Enthalten im iOS-JSON-Backup. Wird gelöscht, wenn du den Podcast abbestellst. Maximal 1000 Zeichen."
          }
        }
      }
    },
    "Local only on this device — not from RSS, not synced to gpodder, and not written to OPML or HTML export. Distinct from episode private notes and bookmarks. Included in iOS JSON backup with other feed settings. Survives refresh; cleared when you unsubscribe. Maximum 1000 characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local only on this device — not from RSS, not synced to gpodder, and not written to OPML or HTML export. Distinct from episode private notes and bookmarks. Included in iOS JSON backup with other feed settings. Survives refresh; cleared when you unsubscribe. Maximum 1000 characters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lokal auf diesem Gerät — nicht aus RSS, nicht mit gpodder synchronisiert und nicht in OPML oder HTML-Export geschrieben. Anders als private Episoden-Notizen und Lesezeichen. Enthalten im iOS-JSON-Backup mit anderen Feed-Einstellungen. Bleibt bei Aktualisierung; wird beim Abbestellen gelöscht. Maximal 1000 Zeichen."
          }
        }
      }
    },
