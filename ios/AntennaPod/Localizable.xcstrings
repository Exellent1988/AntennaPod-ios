    "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full Inbox catalog (same as Mark all / Archive all), not library search. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full Inbox catalog (same as Mark all / Archive all), not library search. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht %lld Posteingangs-Episoden am Ende der Warteschlange ein (neueste zuerst). Bereits eingereihte Episoden werden übersprungen. Nutzt den vollen Posteingangs-Katalog (wie Alle als gehört / Alle archivieren), nicht die Bibliothekssuche. Warteschlangen-Sperre blockiert Einreihen nicht."
          }
        }
      }
    },
    "Appends %lld downloaded episodes to the end of the queue (catalog order — oldest completed first). Already queued episodes are skipped. Uses the full Downloads catalog (same as Delete played downloads), not the chip/search filter. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld downloaded episodes to the end of the queue (catalog order — oldest completed first). Already queued episodes are skipped. Uses the full Downloads catalog (same as Delete played downloads), not the chip/search filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht %lld heruntergeladene Episoden am Ende der Warteschlange ein (Katalogreihenfolge — älteste abgeschlossene zuerst). Bereits eingereihte Episoden werden übersprungen. Nutzt den vollen Downloads-Katalog (wie Gehörte Downloads löschen), nicht Chip-/Suchfilter. Warteschlangen-Sperre blockiert Einreihen nicht."
          }
        }
      }
    },
    "Episodes actions": {
