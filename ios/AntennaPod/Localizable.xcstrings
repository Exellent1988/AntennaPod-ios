        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, this podcast stays above unpinned podcasts on Subscriptions for every sort (Recently updated, Alphabetical, …). Local preference only — not a separate sort mode; not synced to gpodder; cleared when you unsubscribe. Included in iOS JSON backup with other feed settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, bleibt dieser Podcast über nicht angehefteten Podcasts in Abonnements bei jeder Sortierung (Zuletzt aktualisiert, Alphabetisch, …). Nur lokale Einstellung — kein eigener Sortiermodus; nicht mit gpodder synchronisiert; wird beim Abbestellen gelöscht. In iOS-JSON-Backup mit anderen Feed-Einstellungen enthalten."
          }
        }
      }
    },
