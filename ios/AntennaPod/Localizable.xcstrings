        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner für neue Episoden bleiben für jeden Podcast aus. An pro Podcast setzt das nicht außer Kraft. Das postet kein Banner und ändert keine Downloads."
          }
        }
      }
    },
    "Download-failure banners stay off. Failures can still appear in Download errors. Successful downloads are unchanged. This does not post a banner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
