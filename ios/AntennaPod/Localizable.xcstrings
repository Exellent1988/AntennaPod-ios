      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate: played episodes use saved duration (position is cleared when marked played); in-progress use saved position. Does not count rewinds, playback speed, or re-listens. Derived from playback.json — no separate cumulative counter. Time range uses lastPlayedAt (else updatedAt) — episode-level stamps, not per-session listen windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Näherung: Gehörte Episoden nutzen die gespeicherte Dauer (Position wird beim Als gehört markieren gelöscht); begonnene nutzen die gespeicherte Position. Zählt keine Rückspulungen, Wiedergabegeschwindigkeit oder erneutes Hören. Aus playback.json — kein separater Summenzähler. Zeitraum nutzt lastPlayedAt (sonst updatedAt) — Episoden-Zeitstempel, keine Sitzungsfenster."
          }
        }
      }
    },
