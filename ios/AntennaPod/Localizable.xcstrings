        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld history episodes to the end of the queue (newest last-played first). Already queued episodes are skipped. Uses the full History catalog (same as Clear history), not the podcast or searchable filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
