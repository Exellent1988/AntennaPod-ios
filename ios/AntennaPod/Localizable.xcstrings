    },
    "Paste an RSS/Atom podcast feed URL, or use Apple / Index / fyyd search. Preview fetches the feed before you confirm subscribe. When the pasteboard holds an http(s) URL, use Add from Clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an RSS/Atom podcast feed URL, or use Apple / Index / fyyd search. Preview fetches the feed before you confirm subscribe. When the pasteboard holds an http(s) URL, use Add from Clipboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine RSS/Atom-Podcast-Feed-URL ein, oder nutze Apple- / Index- / fyyd-Suche. Vorschau lädt den Feed, bevor du das Abonnement bestätigst. Liegt eine http(s)-URL in der Zwischenablage, nutze „Aus Zwischenablage hinzufügen“."
          }
        }
      }
    },
    "Removes %lld episodes from the entire queue (not only the current filter). Does not stop playback, change progress, mark played, or delete downloads.": {
