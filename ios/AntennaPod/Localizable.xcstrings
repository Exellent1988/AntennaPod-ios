        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate: played episodes use saved duration (position is cleared when marked played); in-progress use saved position. Does not count rewinds, playback speed, or re-listens. Derived from playback.json — no separate cumulative counter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Näherungswert: gehörte Episoden nutzen die gespeicherte Dauer (Position wird beim Markieren als gehört gelöscht); laufende nutzen die gespeicherte Position. Keine Rückspulung, keine Geschwindigkeit, keine erneuten Hörvorgänge. Aus playback.json abgeleitet — kein separater Summenzähler."
          }
        }
      }
    },
