    },
    "Plays this soundbite in the episode player from the start time and pauses at the end. Not a separate clip player. That pause does not mark the episode played or advance Continuous or the queue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays this soundbite in the episode player from the start time and pauses at the end. Not a separate clip player. That pause does not mark the episode played or advance Continuous or the queue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt dieses Soundbite im Episoden-Player ab der Startzeit und pausiert am Ende. Kein separater Clip-Player. Diese Pause markiert die Episode nicht als gehört und setzt Continuous oder die Warteschlange nicht fort."
          }
        }
      }
    },
    "Soundbites come from the feed. Play seeks to the start and pauses at the end of the clip in the episode player; there is no separate clip player. That pause does not mark the episode played or advance Continuous or the queue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundbites come from the feed. Play seeks to the start and pauses at the end of the clip in the episode player; there is no separate clip player. That pause does not mark the episode played or advance Continuous or the queue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundbites stammen aus dem Feed. Abspielen springt zum Start und pausiert am Ende des Clips im Episoden-Player; es gibt keinen separaten Clip-Player. Diese Pause markiert die Episode nicht als gehört und setzt Continuous oder die Warteschlange nicht fort."
          }
        }
      }
    },
    "Extend +%lld min": {
