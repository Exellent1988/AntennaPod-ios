    "CarPlay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay"
          }
        }
      }
    },
    "CarPlay (honest partial): appears via system Now Playing when audio is playing — MPNowPlayingInfoCenter + remote play/pause/skip/seek (Settings intervals; next/previous → skip). Info.plist already has UIBackgroundModes audio; AVAudioSession category .playback. No custom CarPlay templates / CPTemplate scene / CarPlay entitlement. Apple Watch companion is a separate beta-lite target (Continue listening + Play on iPhone).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay (honest partial): appears via system Now Playing when audio is playing — MPNowPlayingInfoCenter + remote play/pause/skip/seek (Settings intervals; next/previous → skip). Info.plist already has UIBackgroundModes audio; AVAudioSession category .playback. No custom CarPlay templates / CPTemplate scene / CarPlay entitlement. Apple Watch companion is a separate beta-lite target (Continue listening + Play on iPhone)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay (ehrlich partiell): erscheint über System-Now-Playing bei laufender Wiedergabe — MPNowPlayingInfoCenter + Remote Play/Pause/Skip/Seek (Einstellungen-Intervalle; weiter/zurück → Skip). Info.plist hat bereits UIBackgroundModes audio; AVAudioSession .playback. Keine eigenen CarPlay-Templates / CPTemplate-Szene / CarPlay-Entitlement. Apple-Watch-Companion ist ein separates Beta-lite-Target (Weiterhören + Play auf iPhone)."
          }
        }
      }
    },
