      },
      "comment": "gpodder.net host field VoiceOver hint"
    },
    "Stored in the Keychain on Login — never in Settings backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in the Keychain on Login — never in Settings backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Login im Keychain gespeichert — nie im Settings-Backup."
          }
        }
      },
      "comment": "Password field VoiceOver hint"
    },
    "Creates a new device id from the device name and forces a full subscription pull next sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a new device id from the device name and forces a full subscription pull next sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugt eine neue Geräte-ID aus dem Gerätenamen und erzwingt beim nächsten Sync einen vollen Abo-Abruf."
          }
        }
      },
      "comment": "Regenerate device id VoiceOver hint"
    },
    "Syncs http(s) subscription feed URLs only. Does not sync episode actions, queue, bookmarks, tags, downloads, or local folders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs http(s) subscription feed URLs only. Does not sync episode actions, queue, bookmarks, tags, downloads, or local folders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert nur http(s)-Abo-Feed-URLs. Keine Episodenaktionen, Warteschlange, Lesezeichen, Tags, Downloads oder lokale Ordner."
          }
        }
      },
      "comment": "Sync now VoiceOver hint"
    },
    "Logs in and stores the password in the Keychain. Sync remains subscriptions-only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs in and stores the password in the Keychain. Sync remains subscriptions-only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet an und speichert das Passwort im Keychain. Sync bleibt abo-only."
          }
        }
      },
      "comment": "Login VoiceOver hint"
    },
    "System follows the iOS appearance. Light and Dark force light or dark mode.": {
      "extractionState": "manual",
      "localizations": {
