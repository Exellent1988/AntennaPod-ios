      }
    },
    "Show, hide, and drag-reorder Home tab sections (Continue, Inbox, Queue, Discover, Recently updated, Favorites). Search filters section labels; Edit/drag reorder is off while searching. Reset restores the full default layout after confirmation. Empty optional sections still hide when they have no items. Favorites is off by default. No Downloads Home section — use the Downloads tab. Same editor as Home toolbar Configure Home.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show, hide, and drag-reorder Home tab sections (Continue, Inbox, Queue, Discover, Recently updated, Favorites). Search filters section labels; Edit/drag reorder is off while searching. Reset restores the full default layout after confirmation. Empty optional sections still hide when they have no items. Favorites is off by default. No Downloads Home section — use the Downloads tab. Same editor as Home toolbar Configure Home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Tab-Abschnitte ein-/ausblenden und per Ziehen neu ordnen (Weiterhören, Posteingang, Warteschlange, Entdecken, Zuletzt aktualisiert, Favoriten). Suche filtert Abschnitts-Labels; Bearbeiten/Ziehen ist während der Suche aus. Zurücksetzen stellt nach Bestätigung das volle Standard-Layout wieder her. Leere optionale Abschnitte bleiben ohne Einträge ausgeblendet. Favoriten ist standardmäßig aus. Kein Downloads-Home-Abschnitt — nutze den Downloads-Tab. Derselbe Editor wie Home-Toolbar „Home konfigurieren“."
          }
        }
      }
    },
    "Episode sort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episode sort"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Episoden-Sortierung"
          }
        }
      }
    },
    "Orders this podcast’s episode list. Saved per podcast; does not follow itunes:type.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orders this podcast’s episode list. Saved per podcast; does not follow itunes:type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet die Episodenliste dieses Podcasts. Pro Podcast gespeichert; folgt nicht itunes:type."
          }
        }
      }
    },
    "This podcast: %@. Feed detail Sort menu saves per podcast. itunes:type does not change sort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This podcast: %@. Feed detail Sort menu saves per podcast. itunes:type does not change sort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Podcast: %@. Das Sortieren-Menü im Feed-Detail speichert pro Podcast. itunes:type ändert die Sortierung nicht."
          }
        }
      }
    },
    "Using global default (%@). Change here or via Feed detail Sort to override for this podcast only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using global default (%@). Change here or via Feed detail Sort to override for this podcast only."
          }
        },
        "de": {
