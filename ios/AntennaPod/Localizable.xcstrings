          }
        }
      }
    },
    "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full Inbox catalog (same as Mark all / Archive all), not library search or the podcast filter. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "comment": "Inbox Add all to queue confirmation — full catalog, not podcast filter or library search.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full Inbox catalog (same as Mark all / Archive all), not library search or the podcast filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt %lld Posteingangs-Episoden ans Ende der Warteschlange an (neueste zuerst). Bereits eingereihte Episoden werden übersprungen. Nutzt den gesamten Posteingangs-Katalog (wie Alle markieren / Alle archivieren), nicht die Bibliothekssuche und nicht den Podcast-Filter. Die Warteschlangen-Sperre blockiert das Einreihen nicht."
          }
        }
      }
    },
    "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full current-Inbox catalog (same as Mark all as played / Archive all), not library search or the podcast filter. Queue lock does not block enqueue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appends %lld Inbox episodes to the end of the queue (newest first). Already queued episodes are skipped. Uses the full current-Inbox catalog (same as Mark all as played / Archive all), not library search or the podcast filter. Queue lock does not block enqueue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht %lld Posteingangs-Episoden am Ende der Warteschlange ein (neueste zuerst). Bereits eingereihte Episoden werden übersprungen. Nutzt den vollen aktuellen Posteingangs-Katalog (wie Alle als gehört markieren / Alle archivieren), nicht die Bibliothekssuche und nicht den Podcast-Filter. Die Warteschlangen-Sperre blockiert das Einreihen nicht."
          }
        }
      }
    },
    "Archives %lld non-archived Inbox episode(s) in the full Inbox catalog (newest first), not the podcast, episode type, search, or sort filter. Archived does not mean played. Does not mark played, delete downloads, or clear the queue.": {
      "extractionState": "manual",
