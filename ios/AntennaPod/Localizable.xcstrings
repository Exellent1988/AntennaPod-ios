          }
        }
      }
    },
    "Seeks to the start of this episode and plays immediately. No confirmation. Does not skip intro, mark unplayed, change the queue, or delete downloads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seeks to the start of this episode and plays immediately. No confirmation. Does not skip intro, mark unplayed, change the queue, or delete downloads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt zum Anfang dieser Episode und spielt sofort. Keine Bestätigung. Überspringt weder Intro noch markiert ungehört, ändert nicht die Queue und löscht keine Downloads."
          }
        }
      }
    },
    "Saves the current playback position as a bookmark immediately. No confirmation. Local only — not synced via gpodder. Distinct from chapters, Share with position, and private notes. Does not change playback, favorites, or the queue.": {
      "extractionState": "manual",
      "localizations": {
